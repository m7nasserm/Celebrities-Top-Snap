      <a id="downloadLink" download="video.mp4">⬇ تحميل الفيديو (MP4)</a>
          <div class="hint" id="fallbackNote" style="display:none; margin-top:8px;">تعذّر التحويل التلقائي إلى MP4 في متصفحك، فتم توفير الفيديو بصيغة WebM بدلاً من ذلك.</div>
        </div>
      </div>
    </section>

    <section class="controls-pane">
      <div class="stack">

        <!-- BACKGROUND + IMAGE — same row, each labeled, columns match the animation row below -->
        <section class="stack-section">
          <div class="image-columns">
            <div class="image-col-main">
              <label class="section-title" style="margin-bottom:6px;">الخلفية</label>
              <div class="color-dot-row" id="presetSwatches"></div>
            </div>
            <div class="image-col-anim">
              <label class="section-title" style="margin-bottom:6px;">الصورة</label>
              <div class="upload-row">
                <div class="upload-box compact">
                  📤 اضغط لرفع صورة
                  <input type="file" id="mainImageInput" accept="image/*">
                </div>
                <img class="upload-thumb" id="uploadThumb" alt="" style="display:none;">
                <div class="file-chip" id="mainImageChip"></div>
              </div>
            </div>
          </div>
        </section>

        <!-- ANIMATION -->
        <section class="stack-section">
          <label class="section-title">الإعدادات</label>
          <div class="image-columns">
            <div class="image-col-main">
              <div class="settings-row">
                <div class="settings-sliders">
                  <div class="slider-row">
                    <label class="title">التكبير: <span id="imgScaleVal">100%</span></label>
                    <input type="range" id="imgScale" min="100" max="220" value="100">
                  </div>
                  <div class="slider-row">
                    <label class="title">أفقي</label>
                    <input type="range" id="imgOffsetX" min="-300" max="300" value="0">
                  </div>
                  <div class="slider-row">
                    <label class="title">رأسي</label>
                    <input type="range" id="imgOffsetY" min="-300" max="300" value="0">
                  </div>
                  <div class="slider-row intensity-row">
                    <label class="title">شدة الحركة: <span id="animIntensityVal">25%</span></label>
                    <input type="range" id="animIntensity" min="0" max="60" value="25">
                  </div>
                </div>
              </div>
            </div>

            <div class="image-col-anim motion-controls">
              <div class="anim-grid-sq" id="animGrid" style="margin-top:0;">
                <button class="anim-sq active" data-v="zoomIn" title="تكبير تدريجي">⤢</button>
                <button class="anim-sq" data-v="zoomOut" title="تصغير تدريجي">⤡</button>
                <button class="anim-sq" data-v="slideRight" title="انزلاق لليمين">→</button>
                <button class="anim-sq" data-v="slideLeft" title="انزلاق لليسار">←</button>
                <button class="anim-sq" data-v="slideUp" title="انزلاق لأعلى">↑</button>
                <button class="anim-sq" data-v="slideDown" title="انزلاق لأسفل">↓</button>
                <button type="button" class="anim-sq center-img-btn" id="centerImgBtn" title="توسيط الصورة" aria-label="توسيط الصورة"><img src="data:image/png;base64," alt=""></button>
              </div>
            </div>
          </div>
        </section>

        <!-- TEXT -->
        <section class="stack-section">
          <label class="section-title">النص</label>
          <div id="textLayersWrap" class="text-columns"></div>
        </section>

        <!-- MUSIC -->
        <section class="stack-section music-section">
          <label class="section-title">الموسيقى</label>
          <div class="seg" id="musicCategoryTabs" style="flex-wrap:wrap;"></div>
          <div class="track-scroll-wrap">
            <button type="button" class="track-scroll-arrow" id="trackScrollRight" title="السابق">‹</button>
            <div class="track-row-scroll" id="musicTrackGrid"></div>
            <button type="button" class="track-scroll-arrow" id="trackScrollLeft" title="التالي">›</button>
          </div>
          <div class="scroll-indicator-track" id="scrollIndicatorTrack">
            <div class="scroll-indicator-thumb" id="scrollIndicatorThumb"></div>
          </div>

          <div class="music-extra">
            <div class="upload-box compact small">
              📤 ارفع مقطعك الخاص
              <input type="file" id="musicInput" accept="audio/*">
            </div>
            <div class="file-chip" id="musicChip"></div>
            <div class="field" id="musicStartField" style="display:none;">
              <label class="title">بداية المقطع: <span id="musicStartVal">0.0s</span></label>
              <input type="range" id="musicStart" min="0" max="0" step="0.1" value="0">
            </div>
            <div class="field-row" style="align-items:center;">
              <div class="field" style="flex:2;">
                <label class="title">مستوى الصوت: <span id="volVal">80%</span></label>
                <input type="range" id="volSlider" min="0" max="100" value="80">
              </div>
              <button class="btn btn-ghost small" id="removeMusicBtn" style="display:none;">✕ إزالة</button>
            </div>
          </div>
        </section>

      </div>
    </section>
  </main>

  <footer class="note">
    يسجّل التصدير الفيديو مباشرة من المعاينة بدقة 1080×1920 لمدة 10 ثوانٍ بمعدل 30 إطار/ثانية، ثم يحوّله تلقائياً إلى MP4 داخل المتصفح (يتطلب هذا التحويل اتصالاً بالإنترنت في أول استخدام لتحميل محرك التحويل، وقد يستغرق دقيقة إضافية). إذا تعذّر التحويل لأي سبب، سيُقدَّم الفيديو بصيغة WebM كبديل يعمل في معظم منصات النشر ومحررات الفيديو.
  </footer>
</div>

