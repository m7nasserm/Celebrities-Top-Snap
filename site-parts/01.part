                    } else if (pcmSampleSize === 24) {
                      track.info.codec = "pcm-s24";
                    } else if (pcmSampleSize === 32) {
                      track.info.codec = "pcm-s32";
                    } else {
                      Logging._warn(`Invalid ipcm sample size ${pcmSampleSize}.`);
                      track.info.codec = null;
                    }
                  } else {
                    if (pcmSampleSize === 16) {
                      track.info.codec = "pcm-s16be";
                    } else if (pcmSampleSize === 24) {
