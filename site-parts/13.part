"},
{key:"Suspense_2",category:"Suspense",categoryLabel:"تشويق",label:"تشويق 2",b64:""},
{key:"Suspense_3",category:"Suspense",categoryLabel:"تشويق",label:"تشويق 3",b64:""}
];

  const state = {
    bg: { presetKey:"red", presetImages:{} },
    image: { el:null, naturalW:0, naturalH:0, offsetX:0, offsetY:0, scale:1, anim:"zoomIn", intensity:25 },
    texts: [
      { text:"عنوان رئيسي جذاب هنا", size:74, color:"#ffffff", kind:"headline", lineSpacing:4 },
      { text:"سطر فرعي يشرح التفاصيل بإيجاز\nويلتف تلقائياً عند الحاجة", size:68, color:"#e9e9f2", kind:"sub", lineSpacing:10 }
    ],
    music: { el:null, fileName:"", volume:0.8, start:0, duration:0, presetKey:null },
    swipe: { show:true }
  };

  let playing = false;
  let previewT = TYPE_END_FRAME/(FPS*DURATION); // start the static editor view past the typing-in animation
  let rafId = null;
  let exporting = false;

  const canvas = document.getElementById("stage");
  const ctx = canvas.getContext("2d");
  const maskImg = new Image();
  maskImg.src = "data:image/png;base64," + MASK_B64;

  const tempCanvas = document.createElement("canvas");
  tempCanvas.width = W; tempCanvas.height = H;
  const tctx = tempCanvas.getContext("2d");

  const swipeVideo = document.createElement("video");
  swipeVideo.src = "data:video/webm;base64," + SWIPE_B64;
  swipeVideo.muted = true;
  swipeVideo.playsInline = true;
  swipeVideo.loop = false;
  let swipeReady = false;
  swipeVideo.addEventListener("loadeddata", ()=>{ swipeReady = true; seekSwipeTo(previewT); renderCurrent(); });
  swipeVideo.addEventListener("seeked", ()=>{ if(!exporting) renderCurrent(); });

  // preload preset background images
  BG_PRESETS.forEach(p=>{
    const img = new Image();
    img.src = "data:image/jpeg;base64," + p.b64;
    state.bg.presetImages[p.key] = img;
    img.onload = ()=>{ if(state.bg.presetKey===p.key) renderCurrent(); };
  });

  function easeInOutSine(t){ return 0.5 - 0.5*Math.cos(Math.PI*t); }
  function lerp(a,b,t){ return a + (b-a)*t; }
  function clamp(v,min,max){ return Math.max(min,Math.min(max,v)); }

  function drawBackground(){
    ctx.save();
    const img = state.bg.presetImages[state.bg.presetKey];
    if(img && img.complete && img.naturalWidth){
      const s = Math.max(W/img.naturalWidth, H/img.naturalHeight);
      const dw = img.naturalWidth*s, dh = img.naturalHeight*s;
      ctx.drawImage(img, (W-dw)/2, (H-dh)/2, dw, dh);
    } else {
      ctx.fillStyle = "#1c1030";
      ctx.fillRect(0,0,W,H);
    }
    ctx.restore();
  }

  function getImageSlack(scaleFactor){
    // How far (px, each direction from center) the current image can pan at a given
    // extra zoom factor before its edge would come inside the frame. Guarantees slide
    // animations (and manual dragging) never expose the background, for any image
    // aspect ratio, any zoom, any intensity — computed, not guessed.
    const im = state.image;
    if(!im.el || !im.naturalW || !im.naturalH) return { x:0, y:0 };
    const baseScale = Math.max(FRAME.w/im.naturalW, FRAME.h/im.naturalH);
    const dw = im.naturalW * baseScale * im.scale * scaleFactor;
    const dh = im.naturalH * baseScale * im.scale * scaleFactor;
    return { x: Math.max(0, (dw-FRAME.w)/2), y: Math.max(0, (dh-FRAME.h)/2) };
  }

  function getAnimTransform(t){
    const im = state.image;
    const e = t; // linear progress — no easing
    const k = im.intensity/100;
    let scaleFactor = 1, offX = 0, offY = 0;
    switch(im.anim){
      case "zoomIn": scaleFactor = 1 + k*e; break;
      case "zoomOut": scaleFactor = 1 + k*(1-e); break;
      case "slideLeft": {
        scaleFactor = 1 + k*0.6;
        const slack = getImageSlack(scaleFactor).x;
        const amp = Math.max(0, Math.min(FRAME.w*k*0.5, slack - Math.abs(im.offsetX)));
        offX = lerp(amp, -amp, e);
        break;
      }
      case "slideRight": {
        scaleFactor = 1 + k*0.6;
        const slack = getImageSlack(scaleFactor).x;
        const amp = Math.max(0, Math.min(FRAME.w*k*0.5, slack - Math.abs(im.offsetX)));
        offX = lerp(-amp, amp, e);
        break;
      }
      case "slideUp": {
        scaleFactor = 1 + k*0.6;
        const slack = getImageSlack(scaleFactor).y;
        const amp = Math.max(0, Math.min(FRAME.h*k*0.5, slack - Math.abs(im.offsetY)));
        offY = lerp(amp, -amp, e);
        break;
      }
      case "slideDown": {
        scaleFactor = 1 + k*0.6;
        const slack = getImageSlack(scaleFactor).y;
        const amp = Math.max(0, Math.min(FRAME.h*k*0.5, slack - Math.abs(im.offsetY)));
        offY = lerp(-amp, amp, e);
        break;
      }
      default: break;
    }
    return { scaleFactor, offX, offY };
  }

  const INTRO_SCALE_FRAMES = 20;
  const INTRO_SCALE_START = 1.15;
  const INTRO_SCALE_END = 1.0;
  function easeOutQuint(x){ return 1 - Math.pow(1-x, 5); }
  function getIntroScale(t){
    // A fixed, always-on settle-in effect on the photo itself (independent of
    // whichever slide/zoom animation is picked) — starts at 115% and settles to
    // 100% quickly, with a smooth, gradual landing rather than an abrupt stop.
    const frameNum = t * FPS * DURATION;
    if(frameNum >= INTRO_SCALE_FRAMES) return INTRO_SCALE_END;
    const progress = clamp(frameNum / INTRO_SCALE_FRAMES, 0, 1);
    const eased = easeOutQuint(progress);
    return INTRO_SCALE_START + (INTRO_SCALE_END - INTRO_SCALE_START) * eased;
  }

  function drawImageLayer(t){
    tctx.clearRect(0,0,W,H);
    const im = state.image;
    if(im.el){
      const anim = getAnimTransform(t);
      const introScale = getIntroScale(t);
      const baseScale = Math.max(FRAME.w/im.naturalW, FRAME.h/im.naturalH);
      const baseW = im.naturalW * baseScale * im.scale;
      const baseH = im.naturalH * baseScale * im.scale;
      const scale = baseScale * im.scale * anim.scaleFactor * introScale;
      const dw = im.naturalW*scale, dh = im.naturalH*scale;

      const isZoom = (im.anim === "zoomIn" || im.anim === "zoomOut");
      let drawX, drawY;
      if(isZoom){
        // Anchor zoom around the middle of the image's upper half (not the dead
        // center) — that's roughly where faces tend to sit, so zooming in/out
        // doesn't drift them out of frame or clip them.
        const anchorFx = 0.5, anchorFy = 0.25;
        const baseCx = FRAME.x + FRAME.w/2 + im.offsetX;
        const baseCy = FRAME.y + FRAME.h/2 + im.offsetY;
        const baseDrawX = baseCx - baseW/2;
        const baseDrawY = baseCy - baseH/2;
        const anchorCanvasX = baseDrawX + anchorFx*baseW;
        const anchorCanvasY = baseDrawY + anchorFy*baseH;
        drawX = anchorCanvasX - anchorFx*dw;
        drawY = anchorCanvasY - anchorFy*dh;
      } else {
        const cx = FRAME.x + FRAME.w/2 + im.offsetX + anim.offX;
        const cy = FRAME.y + FRAME.h/2 + im.offsetY + anim.offY;
        drawX = cx - dw/2;
        drawY = cy - dh/2;
      }
      tctx.drawImage(im.el, drawX, drawY, dw, dh);
    } else {
      tctx.fillStyle = "#20222f";
      tctx.fillRect(FRAME.x, FRAME.y, FRAME.w, FRAME.h);
      tctx.fillStyle = "#6a6d85";
      tctx.font = "600 32px sans-serif";
      tctx.textAlign = "center";
      tctx.fillText("ارفع صورة من تبويب «الصورة»", FRAME.x+FRAME.w/2, FRAME.y+FRAME.h/2);
    }
    if(maskImg.complete && maskImg.naturalWidth){
      tctx.globalCompositeOperation = "destination-in";
      tctx.drawImage(maskImg, 0, 0, W, H);
      tctx.globalCompositeOperation = "source-over";
    }
    ctx.drawImage(tempCanvas, 0, 0);
  }

  function wrapLines(text, font, maxWidth){
    ctx.font = font;
    const paragraphs = text.split(/\n/);
    const lines = [];
    for(const para of paragraphs){
      const words = para.split(/\s+/).filter(Boolean);
      if(words.length === 0){ lines.push(""); continue; }
      let cur = "";
      for(const w of words){
        const test = cur ? cur + " " + w : w;
        if(ctx.measureText(test).width > maxWidth && cur){ lines.push(cur); cur = w; }
        else { cur = test; }
      }
      if(cur) lines.push(cur);
    }
    return lines;
  }

  function computeTypewriterReveal(frameNum){
    // Headline types out first, then the subline — split the 15→45 frame
    // window between them proportionally to each text's length so both
    // finish smoothly regardless of how long the text is.
    const headline = state.texts[0], sub = state.texts[1];
    const hLen = headline ? headline.text.length : 0;
    const sLen = sub ? sub.text.length : 0;
    const totalLen = Math.max(1, hLen + sLen);
    const windowFrames = TYPE_END_FRAME - TYPE_START_FRAME;
    const hFrames = hLen === 0 ? 0 : windowFrames * (hLen/totalLen);
    const hStart = TYPE_START_FRAME, hEnd = TYPE_START_FRAME + hFrames;
    const sStart = hEnd, sEnd = TYPE_END_FRAME;

    function revealCount(len, s, e){
      if(len === 0) return 0;
      if(frameNum <= s) return 0;
      if(frameNum >= e) return len;
      if(e <= s) return len;
      return Math.round(len * (frameNum - s) / (e - s));
    }
    return [ revealCount(hLen, hStart, hEnd), revealCount(sLen, sStart, sEnd) ];
  }

  function drawTextLayers(t){
    const maxWidth = TEXT_BOX.w;
    const centerX = TEXT_BOX.x + TEXT_BOX.w/2;
    let y = TEXT_BOX.y;
    ctx.direction = "rtl";
    ctx.textAlign = "center";
    ctx.textBaseline = "alphabetic";

    const frameNum = t * FPS * DURATION;
    const revealCounts = computeTypewriterReveal(frameNum);

    state.texts.forEach((layer, idx)=>{
      const revealed = layer.text.slice(0, revealCounts[idx]);
      if(!revealed.trim()) return;
      const family = layer.kind === "headline" ? "'PFDinXBlack'" : "'PFDinMedium'";
      const fontStr = `${layer.size}px ${family}`;
      const lines = wrapLines(revealed, fontStr, maxWidth);
      const lineHeight = layer.size * 1.28 + (layer.lineSpacing||0);

      ctx.font = fontStr;
      ctx.fillStyle = layer.color;
      ctx.shadowColor = "rgba(0,0,0,.45)";
      ctx.shadowBlur = 14;
      ctx.shadowOffsetY = 3;

      for(const line of lines){ y += lineHeight; ctx.fillText(line, centerX, y); }
      y += 8;
    });
    ctx.shadowBlur = 0; ctx.shadowOffsetY = 0;
  }

  function drawSwipeIcon(){
    if(!state.swipe.show || !swipeReady) return;
    try{
      ctx.drawImage(swipeVideo, SWIPE_RECT.x, SWIPE_RECT.y, SWIPE_RECT.w, SWIPE_RECT.h);
    }catch(e){}
  }

  function render(t){
    ctx.clearRect(0,0,W,H);
    drawBackground();
    drawImageLayer(t);
    drawTextLayers(t);
    drawSwipeIcon();
  }

  function renderCurrent(){ render(previewT); }

  if(document.fonts && document.fonts.ready){
    Promise.all([
      document.fonts.load("64px PFDinXBlack"),
      document.fonts.load("38px PFDinMedium")
    ]).then(renderCurrent).catch(()=>{});
    document.fonts.ready.then(renderCurrent);
  }
  render(previewT);

  /* ---------------- background controls (fixed brand color swatches) ---------------- */
  const presetSwatchesEl = document.getElementById("presetSwatches");
  BG_PRESETS.forEach(p=>{
    const el = document.createElement("div");
    el.className = "color-dot" + (state.bg.presetKey===p.key ? " active":"");
    el.style.backgroundImage = `url(data:image/jpeg;base64,${p.b64})`;
    el.title = p.label;
    el.innerHTML = `<span>${p.label}</span>`;
    el.addEventListener("click", ()=>{
      state.bg.presetKey = p.key;
      document.querySelectorAll(".color-dot").forEach(s=>s.classList.remove("active"));
      el.classList.add("active");
      renderCurrent();
    });
    presetSwatchesEl.appendChild(el);
  });

  /* ---------------- image controls ---------------- */
  function loadMainImage(src, filename){
    const img = new Image();
    img.onload = ()=>{
      state.image.el = img;
      state.image.naturalW = img.naturalWidth;
      state.image.naturalH = img.naturalHeight;
      state.image.offsetX = 0; state.image.offsetY = 0;
      state.image.scale = 1;
      document.getElementById("imgScale").value = 100;
      document.getElementById("imgScaleVal").textContent = "100%";
      document.getElementById("mainImageChip").textContent = "✓ "+filename;
      const thumb = document.getElementById("uploadThumb");
      thumb.src = src;
      thumb.style.display = "block";
      updateOffsetBounds();
      renderCurrent();
    };
    img.src = src;
  }

  document.getElementById("mainImageInput").addEventListener("change", e=>{
    const file = e.target.files[0]; if(!file) return;
    loadMainImage(URL.createObjectURL(file), file.name);
  });

  // Preloaded default example so the tool shows a finished-looking preview immediately.
  loadMainImage("data:image/jpeg;base64,", "Hala.jpg");

  function getOffsetBounds(){
    const im = state.image;
    const k = im.intensity/100;
    const animScale = 1 + k*0.6;
    let scaleForX = 1, scaleForY = 1;
    if(im.anim === "slideUp" || im.anim === "slideDown") scaleForX = animScale;
    else if(im.anim === "slideLeft" || im.anim === "slideRight") scaleForY = animScale;
    return { x: getImageSlack(scaleForX).x, y: getImageSlack(scaleForY).y };
  }

  function updateOffsetBounds(){
    const bounds = getOffsetBounds();
    const maxX = Math.round(bounds.x), maxY = Math.round(bounds.y);
    const xSlider = document.getElementById("imgOffsetX");
    const ySlider = document.getElementById("imgOffsetY");
    xSlider.min = -maxX; xSlider.max = maxX;
    ySlider.min = -maxY; ySlider.max = maxY;
    state.image.offsetX = clamp(state.image.offsetX, -maxX, maxX);
    state.image.offsetY = clamp(state.image.offsetY, -maxY, maxY);
    xSlider.value = state.image.offsetX;
    ySlider.value = state.image.offsetY;
  }

  document.getElementById("imgScale").addEventListener("input", e=>{
    state.image.scale = (+e.target.value)/100;
    document.getElementById("imgScaleVal").textContent = e.target.value+"%";
    updateOffsetBounds();
    renderCurrent();
  });
  document.getElementById("imgOffsetX").addEventListener("input", e=>{ state.image.offsetX = +e.target.value; renderCurrent(); });
  document.getElementById("imgOffsetY").addEventListener("input", e=>{ state.image.offsetY = +e.target.value; renderCurrent(); });
  const centerImgBtn = document.getElementById("centerImgBtn");
  let centerPressTimer;
  centerImgBtn.addEventListener("click", ()=>{
    centerImgBtn.classList.remove("pressed");
    void centerImgBtn.offsetWidth; // Restart the feedback on repeated clicks.
    centerImgBtn.classList.add("pressed");
    clearTimeout(centerPressTimer);
    centerPressTimer = setTimeout(()=>centerImgBtn.classList.remove("pressed"), 500);
    state.image.offsetX = 0; state.image.offsetY = 0;
    document.getElementById("imgOffsetX").value = 0;
    document.getElementById("imgOffsetY").value = 0;
    renderCurrent();
  });

  const animGrid = document.getElementById("animGrid");
  animGrid.addEventListener("click", e=>{
    const btn = e.target.closest(".anim-sq[data-v]"); if(!btn) return;
    [...animGrid.children].forEach(b=>b.classList.remove("active"));
    btn.classList.add("active");
    state.image.anim = btn.dataset.v;
    updateOffsetBounds();
    renderCurrent();
  });
  document.getElementById("animIntensity").addEventListener("input", e=>{
    state.image.intensity = +e.target.value;
    document.getElementById("animIntensityVal").textContent = e.target.value+"%";
    updateOffsetBounds();
    renderCurrent();
  });

  const stageWrap = document.getElementById("stageWrap");
  let dragging = false, dragStart = null;
  stageWrap.addEventListener("pointerdown", e=>{
    if(playing || exporting || !state.image.el) return;
    dragging = true;
    stageWrap.classList.add("dragging");
    dragStart = { x:e.clientX, y:e.clientY, ox:state.image.offsetX, oy:state.image.offsetY };
    stageWrap.setPointerCapture(e.pointerId);
  });
  stageWrap.addEventListener("pointermove", e=>{
    if(!dragging) return;
    const rect = stageWrap.getBoundingClientRect();
    const scaleX = W/rect.width, scaleY = H/rect.height;
    const dx = (e.clientX-dragStart.x)*scaleX;
    const dy = (e.clientY-dragStart.y)*scaleY;
    const slack = getOffsetBounds();
    state.image.offsetX = clamp(dragStart.ox+dx, -slack.x, slack.x);
    state.image.offsetY = clamp(dragStart.oy+dy, -slack.y, slack.y);
    document.getElementById("imgOffsetX").value = state.image.offsetX;
    document.getElementById("imgOffsetY").value = state.image.offsetY;
    renderCurrent();
  });
  stageWrap.addEventListener("pointerup", ()=>{ dragging=false; stageWrap.classList.remove("dragging"); });
  stageWrap.addEventListener("pointercancel", ()=>{ dragging=false; stageWrap.classList.remove("dragging"); });

  /* ---------------- text layers ---------------- */
  const textLayersWrap = document.getElementById("textLayersWrap");

  function renderTextLayers(){
    textLayersWrap.innerHTML = "";
    state.texts.forEach((layer, idx)=>{
      const card = document.createElement("div");
      card.className = "text-layer-card";
      const isHeadline = layer.kind === "headline";
      const advId = "adv-"+idx;
      card.innerHTML = `
        <div class="field">
          <label class="title">${isHeadline ? "العنوان الرئيسي" : "النص الفرعي"}</label>
          <textarea data-field="text" data-idx="${idx}">${layer.text}</textarea>
          <div class="hint">يلتف النص تلقائياً عند تجاوز عرض الصندوق، ويمكنك الضغط على Enter للانتقال إلى سطر جديد يدوياً في أي وقت.</div>
        </div>
        <button type="button" class="adv-toggle" data-adv="${advId}">
          <span class="arrow">▶</span> إظهار خيارات متقدمة (حجم الخط، تباعد الأسطر، واللون)
        </button>
        <div class="adv-body" id="${advId}">
          <div class="field-row">
            <div class="field">
              <label class="title">الحجم: <span data-out="size">${layer.size}px</span></label>
              <input type="range" min="20" max="110" value="${layer.size}" data-field="size" data-idx="${idx}">
            </div>
            <div class="field">
              <label class="title">اللون</label>
              <div class="color-row"><input type="color" value="${layer.color}" data-field="color" data-idx="${idx}"></div>
            </div>
          </div>
          <div class="field">
            <label class="title">تباعد الأسطر: <span data-out="lineSpacing">${layer.lineSpacing}px</span></label>
            <input type="range" min="0" max="20" value="${layer.lineSpacing}" data-field="lineSpacing" data-idx="${idx}">
          </div>
        </div>
      `;
      card.querySelector('[data-field="text"]').addEventListener("input", e=>{ state.texts[idx].text = e.target.value; renderCurrent(); });
      card.querySelector('[data-field="size"]').addEventListener("input", e=>{
        state.texts[idx].size = +e.target.value;
        card.querySelector('[data-out="size"]').textContent = e.target.value+"px";
        renderCurrent();
      });
      card.querySelector('[data-field="color"]').addEventListener("input", e=>{ state.texts[idx].color = e.target.value; renderCurrent(); });
      card.querySelector('[data-field="lineSpacing"]').addEventListener("input", e=>{
        state.texts[idx].lineSpacing = +e.target.value;
        card.querySelector('[data-out="lineSpacing"]').textContent = e.target.value+"px";
        renderCurrent();
      });
      const advToggle = card.querySelector(".adv-toggle");
      const advBody = card.querySelector(".adv-body");
      advToggle.addEventListener("click", ()=>{
        const isOpen = advBody.classList.toggle("open");
        advToggle.classList.toggle("open", isOpen);
        advToggle.innerHTML = `<span class="arrow">▶</span> ${isOpen ? "إخفاء خيارات متقدمة" : "إظهار خيارات متقدمة (حجم الخط، تباعد الأسطر، واللون)"}`;
      });
      textLayersWrap.appendChild(card);
    });
  }
  renderTextLayers();

  /* ---------------- music controls ---------------- */
  const musicInput = document.getElementById("musicInput");
  const musicStartSlider = document.getElementById("musicStart");
  const musicStartField = document.getElementById("musicStartField");
  const removeMusicBtn = document.getElementById("removeMusicBtn");
  const musicCategoryTabs = document.getElementById("musicCategoryTabs");
  const musicTrackGrid = document.getElementById("musicTrackGrid");

  const MUSIC_CATEGORIES = ["All", ...Array.from(new Set(MUSIC_LIBRARY.map(t=>t.category)))];
  let activeCategory = "All";
  let previewAudio = null;
  let previewingKey = null;

  function stopPreviewAudio(){
    if(previewAudio){ previewAudio.pause(); previewAudio = null; }
    previewingKey = null;
    document.querySelectorAll(".track-play").forEach(b=>b.textContent = "▶");
  }

  function selectPresetTrack(track){
    stopPreviewAudio();
    const audio = new Audio("data:audio/mpeg;base64," + track.b64);
    audio.preload = "metadata";
    audio.addEventListener("loadedmetadata", ()=>{
      state.music.el = audio;
      state.music.fileName = track.key.replace("_"," ");
      state.music.duration = audio.duration;
      state.music.start = 0;
      state.music.presetKey = track.key;
      state.music.el.volume = state.music.volume;
      musicStartField.style.display = "none";
      removeMusicBtn.style.display = "inline-flex";
      musicInput.value = "";
      document.getElementById("musicChip").textContent = "";
      renderTrackGrid();
    });
  }

  function renderCategoryTabs(){
    musicCategoryTabs.innerHTML = "";
    MUSIC_CATEGORIES.forEach(cat=>{
      const btn = document.createElement("button");
      btn.textContent = cat;
      btn.type = "button";
      if(cat === activeCategory) btn.classList.add("active");
      btn.addEventListener("click", ()=>{
        activeCategory = cat;
        renderCategoryTabs();
        renderTrackGrid();
      });
      musicCategoryTabs.appendChild(btn);
    });
  }
  renderCategoryTabs();

  function renderTrackGrid(){
    musicTrackGrid.innerHTML = "";
    const list = activeCategory === "All" ? MUSIC_LIBRARY : MUSIC_LIBRARY.filter(t=>t.category===activeCategory);
    list.forEach(track=>{
      const card = document.createElement("div");
      card.className = "track-card" + (state.music.presetKey===track.key ? " active":"");
      card.innerHTML = `
        <button type="button" class="track-play" data-key="${track.key}">▶</button>
        <span class="track-name">${track.key.replace("_"," ")}</span>
        <span class="track-check">✓</span>
      `;
      card.addEventListener("click", (e)=>{
        if(e.target.closest(".track-play")) return;
        selectPresetTrack(track);
      });
      card.querySelector(".track-play").addEventListener("click", (e)=>{
        e.stopPropagation();
        if(previewingKey === track.key){ stopPreviewAudio(); return; }
        stopPreviewAudio();
        previewAudio = new Audio("data:audio/mpeg;base64," + track.b64);
        previewAudio.volume = 0.8;
        previewAudio.play().catch(()=>{});
        previewingKey = track.key;
        e.currentTarget.textContent = "⏸";
        previewAudio.addEventListener("ended", stopPreviewAudio);
      });
      musicTrackGrid.appendChild(card);
    });
    setTrackGridColumnWidth();
    requestAnimationFrame(updateScrollIndicator);
  }
  renderTrackGrid();

  /* Fixed-pixel column width for the track grid, computed in JS rather than via CSS
     percentages. CSS grid-auto-columns:calc(%) has a real circular-dependency bug when
     a grid sits inside a flex/auto-sized container and doesn't have enough items to
     naturally fill 3 columns — the percentage resolves against the wrong base width and
     cards shrink (this is exactly what caused Suspense/News/Generic to render tiny while
     "All", with plenty of columns, looked fine). Measuring the stable outer section's
     width directly and setting an explicit px value sidesteps that bug entirely. */
  function setTrackGridColumnWidth(){
    const section = musicTrackGrid.closest(".music-section");
    if(!section) return;
    const totalWidth = section.clientWidth;
    const arrowsAndGaps = 32*2 + 8*2; // two 32px arrow buttons + two 8px gaps in .track-scroll-wrap
    const available = Math.max(300, totalWidth - arrowsAndGaps);
    const colWidth = Math.max(180, (available - 20) / 3); // minus the 2 internal 10px grid gaps between 3 columns
    musicTrackGrid.style.gridAutoColumns = colWidth + "px";
    // Share the *total* span of the 3 visible columns (including their 2 internal
    // 10px gaps) so other fixed-size cards (text headline/subline) can match the
    // same outer boundary — e.g. 2 text cards + their gap = same total width as
    // the 3 track columns + their gaps, keeping both rows' left/right edges aligned.
    const threeColumnSpan = colWidth*3 + 10*2;
    document.documentElement.style.setProperty("--music-3col-width", threeColumnSpan + "px");
  }
  window.addEventListener("resize", ()=>{ setTrackGridColumnWidth(); requestAnimationFrame(updateScrollIndicator); });

  /* custom always-visible scroll indicator for the track row — doesn't rely on
     native OS scrollbars, which some systems (notably macOS) hide by default
     regardless of any CSS the page applies. */
  const scrollIndicatorTrack = document.getElementById("scrollIndicatorTrack");
  const scrollIndicatorThumb = document.getElementById("scrollIndicatorThumb");
  const trackScrollLeftBtn = document.getElementById("trackScrollLeft");
  const trackScrollRightBtn = document.getElementById("trackScrollRight");

  function updateScrollIndicator(){
    const el = musicTrackGrid;
    const maxScroll = el.scrollWidth - el.clientWidth;
    if(maxScroll <= 2){
      scrollIndicatorTrack.style.visibility = "hidden";
      trackScrollLeftBtn.disabled = true;
      trackScrollRightBtn.disabled = true;
      return;
    }
    scrollIndicatorTrack.style.visibility = "visible";
    const trackWidthPx = scrollIndicatorTrack.clientWidth;
    const thumbWidthPx = Math.max(trackWidthPx*0.12, (el.clientWidth/el.scrollWidth)*trackWidthPx);
    const ratio = clamp(Math.abs(el.scrollLeft)/maxScroll, 0, 1); // 0 = start(right), 1 = end(left) in RTL
    const maxTranslatePx = trackWidthPx - thumbWidthPx;
    // translateX(%) is relative to the thumb's OWN width, not the track — use px instead
    // so the thumb actually reaches the far edge when fully scrolled.
    scrollIndicatorThumb.style.width = thumbWidthPx+"px";
    scrollIndicatorThumb.style.transform = `translateX(${-(ratio*maxTranslatePx)}px)`;
    trackScrollRightBtn.disabled = ratio <= 0.01;
    trackScrollLeftBtn.disabled = ratio >= 0.99;
  }
  musicTrackGrid.addEventListener("scroll", updateScrollIndicator);

  trackScrollLeftBtn.addEventListener("click", ()=>{ musicTrackGrid.scrollBy({left:-260, behavior:"smooth"}); });
  trackScrollRightBtn.addEventListener("click", ()=>{ musicTrackGrid.scrollBy({left:260, behavior:"smooth"}); });

  scrollIndicatorTrack.addEventListener("click", (e)=>{
    const rect = scrollIndicatorTrack.getBoundingClientRect();
    const clickRatio = clamp((rect.right - e.clientX)/rect.width, 0, 1);
    const maxScroll = musicTrackGrid.scrollWidth - musicTrackGrid.clientWidth;
    musicTrackGrid.scrollTo({left: -(clickRatio*maxScroll), behavior:"smooth"});
  });

  musicInput.addEventListener("change", e=>{
    const file = e.target.files[0]; if(!file) return;
    stopPreviewAudio();
    const url = URL.createObjectURL(file);
    const audio = new Audio();
    audio.src = url;
    audio.preload = "metadata";
    audio.addEventListener("loadedmetadata", ()=>{
      state.music.el = audio;
      state.music.fileName = file.name;
      state.music.duration = audio.duration;
      state.music.presetKey = null;
      state.music.el.volume = state.music.volume;
      document.getElementById("musicChip").textContent = "✓ "+file.name;
      const maxStart = Math.max(0, audio.duration - DURATION);
      musicStartSlider.max = maxStart.toFixed(1);
      musicStartSlider.value = 0;
      state.music.start = 0;
      document.getElementById("musicStartVal").textContent = "0.0s";
      musicStartField.style.display = maxStart > 0.05 ? "flex" : "none";
      removeMusicBtn.style.display = "inline-flex";
      renderTrackGrid();
    });
  });

  document.getElementById("volSlider").addEventListener("input", e=>{
    state.music.volume = (+e.target.value)/100;
    document.getElementById("volVal").textContent = e.target.value+"%";
    if(state.music.el) state.music.el.volume = state.music.volume;
  });

  musicStartSlider.addEventListener("input", e=>{
    state.music.start = +e.target.value;
    document.getElementById("musicStartVal").textContent = (+e.target.value).toFixed(1)+"s";
  });

  removeMusicBtn.addEventListener("click", ()=>{
    stopPreviewAudio();
    state.music.el = null;
    state.music.fileName = "";
    state.music.presetKey = null;
    musicInput.value = "";
    document.getElementById("musicChip").textContent = "";
    musicStartSlider.max = 0; musicStartSlider.value = 0;
    musicStartField.style.display = "none";
    removeMusicBtn.style.display = "none";
    renderTrackGrid();
  });


  /* ---------------- playback ---------------- */
  const scrubber = document.getElementById("scrubber");
  const timeLabel = document.getElementById("timeLabel");
  const playBtn = document.getElementById("playBtn");

  function updateTimeUI(){
    const secs = previewT*DURATION;
    timeLabel.textContent = secs.toFixed(1)+" / "+DURATION.toFixed(1)+"s";
    scrubber.value = Math.round(previewT*300);
  }

  function seekSwipeTo(t){
    if(!swipeReady) return;
    const target = Math.min(t*DURATION, swipeVideo.duration - 0.03);
    if(Math.abs(swipeVideo.currentTime - target) > 0.05){
      swipeVideo.currentTime = Math.max(0,target);
    }
  }

  scrubber.addEventListener("input", e=>{
    if(playing) return;
    previewT = (+e.target.value)/300;
    seekSwipeTo(previewT);
    render(previewT);
    updateTimeUI();
  });

  function stopPreview(){
    playing = false;
    playBtn.textContent = "▶ تشغيل المعاينة";
    if(rafId) cancelAnimationFrame(rafId);
    if(state.music.el){ state.music.el.pause(); }
    swipeVideo.pause();
  }

  function startPreview(){
    playing = true;
    playBtn.textContent = "⏸ إيقاف مؤقت";
    const startWall = performance.now() - previewT*DURATION*1000;

    if(state.music.el){
      state.music.el.currentTime = state.music.start + previewT*DURATION;
      state.music.el.volume = state.music.volume;
      state.music.el.play().catch(()=>{});
    }
    if(swipeReady){
      swipeVideo.currentTime = previewT*DURATION;
      swipeVideo.play().catch(()=>{});
    }

    function tick(now){
      if(!playing) return;
      let elapsed = (now-startWall)/1000;
      let t = elapsed/DURATION;

      if(t >= 1){
        previewT = 1;
        render(previewT);
        updateTimeUI();
        stopPreview();
        return;
      }

      previewT = t;
      render(previewT);
      updateTimeUI();
      if(state.music.el && Math.abs(state.music.el.currentTime - (state.music.start+t*DURATION)) > 0.35){
        state.music.el.currentTime = state.music.start + t*DURATION;
      }
      rafId = requestAnimationFrame(tick);
    }
    rafId = requestAnimationFrame(tick);
  }

  playBtn.addEventListener("click", ()=>{
    if(exporting) return;
    if(playing){ stopPreview(); return; }
    if(previewT >= 1){ previewT = 0; seekSwipeTo(0); render(0); updateTimeUI(); }
    startPreview();
  });

  document.getElementById("resetBtn").addEventListener("click", ()=>{
    stopPreview();
    previewT = 0;
    seekSwipeTo(0);
    render(0);
    updateTimeUI();
  });

  updateTimeUI();

  /* ---------------- deterministic MP4 export ---------------- */
  const exportBtn = document.getElementById("exportBtn");
  const exportBox = document.getElementById("exportBox");
  const exportStatus = document.getElementById("exportStatus");
  const progressFill = document.getElementById("progressFill");
  const exportResult = document.getElementById("exportResult");
  const resultVideo = document.getElementById("resultVideo");
  const downloadLink = document.getElementById("downloadLink");
  let lastExportUrl = null;

  // Decode once and place the chosen start of the track on a fixed 10-second timeline.
  async function makeExportAudioBuffer(){
    if(!state.music.el) return null;
    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
    if(!AudioContextClass) throw new Error("متصفحك لا يدعم معالجة الصوت المطلوبة للتصدير.");
    const audioContext = new AudioContextClass();
    try{
      const response = await fetch(state.music.el.src);
      if(!response.ok) throw new Error("تعذّر قراءة ملف الموسيقى.");
      const decoded = await audioContext.decodeAudioData(await response.arrayBuffer());
      const sampleRate = decoded.sampleRate;
      const length = Math.round(DURATION * sampleRate);
      const channels = Math.min(decoded.numberOfChannels, 2);
      const audio = audioContext.createBuffer(channels, length, sampleRate);
      const offset = Math.max(0, Math.round(state.music.start * sampleRate));
      const count = Math.max(0, Math.min(length, decoded.length - offset));
      for(let channel = 0; channel < channels; channel++){
        const source = decoded.getChannelData(channel);
        const destination = audio.getChannelData(channel);
        const volume = state.music.volume;
        for(let i = 0; i < count; i++) destination[i] = source[offset + i] * volume;
      }
      return audio;
    } finally {
      await audioContext.close();
    }
  }

  function seekSwipeForExport(seconds){
    if(!state.swipe.show || !swipeReady) return Promise.resolve();
    if(Math.abs(swipeVideo.currentTime - seconds) < 0.005) return Promise.resolve();
    return new Promise((resolve, reject)=>{
      const timer = setTimeout(()=>{
        cleanup();
        reject(new Error("تعذّر الوصول إلى إطار حركة السحب في الوقت المطلوب."));
      }, 10000);
      function cleanup(){
        clearTimeout(timer);
        swipeVideo.removeEventListener("seeked", onSeeked);
        swipeVideo.removeEventListener("error", onError);
      }
      function onSeeked(){ cleanup(); resolve(); }
      function onError(){ cleanup(); reject(new Error("تعذّر قراءة فيديو حركة السحب.")); }
      swipeVideo.addEventListener("seeked", onSeeked);
      swipeVideo.addEventListener("error", onError);
      try{ swipeVideo.currentTime = seconds; } catch(error){ cleanup(); reject(error); }
    });
  }

  exportBtn.addEventListener("click", async ()=>{
    if(exporting) return;
    if(!window.VideoEncoder || !window.Mediabunny){
      alert("يتطلب تصدير MP4 متصفحاً حديثاً يدعم WebCodecs، مثل Chrome أو Edge الحديث.");
      return;
    }
    exporting = true;
    stopPreview();
    swipeVideo.pause();
    exportBtn.disabled = true;
    exportBox.classList.add("show");
    exportResult.classList.remove("show");
    exportStatus.textContent = "جارٍ تجهيز MP4…";
    progressFill.style.width = "0%";
    let output = null;
    try{
      await document.fonts.ready;
      const {Output, Mp4OutputFormat, BufferTarget, CanvasSource, AudioBufferSource, Quality} = window.Mediabunny;
      const audio = await makeExportAudioBuffer();
      if(audio && !(await window.Mediabunny.canEncodeAudio("aac"))){
        window.MediabunnyAacEncoder.registerAacEncoder();
      }
      output = new Output({format:new Mp4OutputFormat(), target:new BufferTarget()});
      const videoSource = new CanvasSource(canvas, {
        codec:"avc", quality:new Quality({bitrate:8_000_000})
      });
      output.addVideoTrack(videoSource, {frameRate:FPS});
      if(audio){
        const audioSource = new AudioBufferSource({
          codec:"aac", quality:new Quality({bitrate:160_000})
        });
        output.addAudioTrack(audioSource);
        await output.start();
        await audioSource.add(audio);
      } else {
        await output.start();
      }
      const totalFrames = FPS * DURATION;
      for(let frame = 0; frame < totalFrames; frame++){
        const seconds = frame / FPS;
        await seekSwipeForExport(seconds);
        render(frame / totalFrames);
        await videoSource.add(seconds, 1 / FPS, {keyFrame:frame % (FPS * 2) === 0});
        progressFill.style.width = ((frame + 1) / totalFrames * 95).toFixed(0) + "%";
        exportStatus.textContent = "جارٍ تصدير MP4… " + (frame + 1) + "/" + totalFrames;
        if(frame % 5 === 0) await new Promise(resolve=>setTimeout(resolve, 0));
      }
      exportStatus.textContent = "جارٍ إنهاء ملف MP4…";
      await output.finalize();
      const mp4Blob = new Blob([output.target.buffer], {type:"video/mp4"});
      if(lastExportUrl) URL.revokeObjectURL(lastExportUrl);
      lastExportUrl = URL.createObjectURL(mp4Blob);
      resultVideo.src = lastExportUrl;
      downloadLink.href = lastExportUrl;
      const stamp = new Date().toISOString().slice(0,19).replace(/[:T]/g,"-");
      downloadLink.download = "celebrities-top-snap-" + stamp + ".mp4";
      document.getElementById("fallbackNote").style.display = "none";
      exportStatus.textContent = "✓ اكتمل التصدير (MP4)";
      progressFill.style.width = "100%";
      exportResult.classList.add("show");
    } catch(error){
      if(output){ try{ await output.cancel(); }catch(e){} }
      const message = error && error.message ? error.message : String(error);
      console.error("MP4 export failed:", error);
      exportStatus.textContent = "تعذّر تصدير MP4: " + message;
    } finally {
      exporting = false;
      exportBtn.disabled = false;
      seekSwipeTo(previewT);
      renderCurrent();
    }
  });

})();
</script>
</body>
</html>
