<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Celebrities Top Snap — استوديو الفيديوهات</title>

<style>
  @font-face{
    font-family: 'PFDinXBlack';
    src: url(data:font/woff;base64,) format('woff');
    font-weight: 900; font-display: block;
  }
  @font-face{
    font-family: 'PFDinMedium';
    src: url(data:font/woff;base64,) format('woff');
    font-weight: 500; font-display: block;
  }
  @font-face{ font-family:'Tajawal'; src:url(data:font/woff;base64,) format('woff'); font-weight:200; font-display:swap; }
  @font-face{ font-family:'Tajawal'; src:url(data:font/woff;base64,) format('woff'); font-weight:300; font-display:swap; }
  @font-face{ font-family:'Tajawal'; src:url(data:font/woff;base64,) format('woff'); font-weight:400; font-display:swap; }
  @font-face{ font-family:'Tajawal'; src:url(data:font/woff;base64,) format('woff'); font-weight:500; font-display:swap; }
  @font-face{ font-family:'Tajawal'; src:url(data:font/woff;base64,) format('woff'); font-weight:700; font-display:swap; }
  @font-face{ font-family:'Tajawal'; src:url(data:font/woff;base64,) format('woff'); font-weight:800; font-display:swap; }
  @font-face{ font-family:'Tajawal'; src:url(data:font/woff;base64,) format('woff'); font-weight:900; font-display:swap; }
  :root{
    --bg: #F6F5FB;
    --panel: #FFFFFF;
    --panel-2: #F4F2FA;
    --line: #E7E3F5;
    --text: #14121F;
    --muted: #74718A;
    --accent: #7D2AE7;
    --accent-2: #00C4CC;
    --accent-grad: linear-gradient(135deg,#7D2AE7,#3969E7 55%,#00C4CC);
    --good: #00B37E;
    --shadow-sm: 0 1px 2px rgba(30,15,70,.06), 0 1px 1px rgba(30,15,70,.04);
    --shadow-md: 0 12px 28px -10px rgba(46,20,110,.18), 0 2px 6px rgba(46,20,110,.06);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background: var(--bg);
    color: var(--text);
    font-family: 'Tajawal', 'Tahoma', sans-serif;
    min-height:100vh;
  }
  .app{ display:flex; flex-direction:column; min-height:100vh; }
  header{
    padding:16px 28px;
    display:flex; align-items:center; gap:14px;
    border-bottom:1px solid var(--line);
    background: var(--panel);
  }
  header .mark{
    width:38px;height:38px;border-radius:12px;
    background:var(--accent-grad);
    display:flex;align-items:center;justify-content:center;
    font-weight:900; font-size:18.75px; color:#fff; flex-shrink:0;
    font-family:'Tajawal';
    box-shadow: var(--shadow-sm);
  }
  header h1{font-size:22.5px;margin:0;font-weight:700;font-family:'Tajawal';letter-spacing:.3px;color:var(--text);}
  header p{margin:0;color:var(--muted);font-size:15.625px;}
  main{ flex:1; display:grid; grid-template-columns: minmax(320px,420px) 1fr; gap:0; }
  @media (max-width: 880px){ main{grid-template-columns:1fr;} }

  .preview-pane{
    display:flex; flex-direction:column; align-items:center; justify-content:flex-start;
    padding:26px 18px 30px; gap:16px;
    background: #EFEDF9;
    border-inline-end:1px solid var(--line);
    order:2;
  }
  @media (max-width:880px){ .preview-pane{ order:1; border-inline-end:none; border-bottom:1px solid var(--line);} }

  .stage-wrap{
    position:relative; width: min(300px, 78vw); aspect-ratio: 9/16;
    border-radius:22px; overflow:hidden;
    box-shadow: var(--shadow-md), 0 0 0 1px var(--line);
    background:#000; cursor: grab;
  }
  .stage-wrap.dragging{cursor:grabbing;}
  #stage{ width:100%;height:100%;display:block; }

  .scrubber-row{ width:min(300px,78vw); display:flex; align-items:center; gap:10px; }
  .scrubber-row input[type=range]{flex:1;}
  .time-label{font-size:14.375px;color:var(--muted); font-variant-numeric: tabular-nums; min-width:64px; text-align:center; direction:ltr; unicode-bidi:isolate;}

  .transport{ display:flex; gap:10px; align-items:center; }
  .btn{
    border:none; border-radius:100px; padding:10px 18px;
    font-family:inherit; font-weight:700; font-size:16.875px;
    cursor:pointer; display:flex; align-items:center; gap:8px;
    transition: transform .12s ease, filter .12s ease, box-shadow .12s ease;
  }
  .btn:active{transform:scale(.96);}
  .btn-primary{ background:var(--accent-grad); color:#fff; box-shadow: var(--shadow-sm); }
  .btn-primary:hover{filter:brightness(1.06); box-shadow: var(--shadow-md);}
  .btn-ghost{ background:var(--panel); color:var(--text); border:1.5px solid var(--line); }
  .btn-ghost:hover{ background:var(--panel-2); border-color:#d5cff0; }
  .btn-export{ width:min(300px,78vw); justify-content:center; padding:13px 16px; font-size:18.125px; }
  .btn:disabled{ opacity:.5; cursor:not-allowed; }

  .export-box{
    width:min(300px,78vw); background:var(--panel); border:1px solid var(--line);
    border-radius:16px; padding:12px 14px; font-size:15.625px; color:var(--muted); display:none;
    box-shadow: var(--shadow-sm);
  }
  .export-box.show{display:block;}
  .progress-bar{ height:6px; border-radius:4px; background:var(--panel-2); overflow:hidden; margin-top:8px; }
  .progress-fill{ height:100%; width:0%; background:var(--accent-grad); transition:width .1s linear; }
  .export-result{ margin-top:10px; display:none; }
  .export-result.show{display:block;}
  .export-result video{ width:100%; border-radius:12px; display:block; margin-bottom:8px; box-shadow: var(--shadow-sm);}
  .export-result a{
    display:block; text-align:center; background:var(--good); color:#fff; font-weight:800;
    padding:10px; border-radius:100px; text-decoration:none; font-size:16.25px;
  }

  .controls-pane{ order:3; display:flex; flex-direction:column; min-height:0; min-width:0; background:var(--panel); }
  @media (max-width:880px){ .controls-pane{order:2;} }

  .stack{
    display:flex; flex-direction:column; gap:16px;
    padding:20px 22px 24px; flex:1; min-height:0; min-width:0; overflow-y:auto; overflow-x:hidden;
    max-width:1300px; width:100%; margin:0 auto;
  }
  .stack-section{ flex-shrink:0; min-width:0; display:flex; flex-direction:column; gap:10px; }
  .section-title{
    font-size:16.25px; font-weight:800; color:var(--text); font-family:'Tajawal';
    padding-bottom:8px; border-bottom:1.5px solid var(--line);
  }

  .field{ display:flex; flex-direction:column; gap:8px; }
  .field-row{ display:flex; gap:12px; }
  .field-row > .field{ flex:1; }
  label.title{ font-size:15.625px; font-weight:700; color:var(--text); font-family:'Tajawal'; }
  .hint{ font-size:13.75px; color:var(--muted); margin-top:-4px;}

  select, input[type=text], input[type=number], textarea{
    background:var(--panel-2); border:1.5px solid var(--line); color:var(--text);
    border-radius:10px; padding:9px 11px; font-family:inherit; font-size:16.875px; outline:none;
  }
  select:focus, input:focus, textarea:focus{ border-color: var(--accent); }
  textarea{ resize:vertical; min-height:44px; }

  input[type=range]{ -webkit-appearance:none; appearance:none; height:5px; border-radius:4px; background:var(--line); outline:none; }
  input[type=range]::-webkit-slider-thumb{
    -webkit-appearance:none; appearance:none; width:16px;height:16px;border-radius:50%;
    background:var(--accent-grad); cursor:pointer; box-shadow:0 0 0 4px rgba(125,42,231,.14);
  }

  input[type=color]{
    -webkit-appearance:none; appearance:none; width:42px; height:34px; border:1.5px solid var(--line);
    border-radius:9px; background:none; padding:2px; cursor:pointer;
  }
  .color-row{ display:flex; align-items:center; gap:10px; }
  .color-row span{ font-size:15px; color:var(--muted); }

  /* background: labeled rounded-rect color swatches */
  .color-dot-row{ display:flex; gap:72px; flex-wrap:wrap; flex-shrink:0; justify-content:flex-start; padding-right:40px; }
  .color-dot{
    width:52px; height:74px; border-radius:10px; flex-shrink:0;
    background-size:cover; background-position:center; cursor:pointer;
    border:2.5px solid transparent; box-shadow: var(--shadow-sm);
    position:relative; display:flex; align-items:flex-end; justify-content:center;
    overflow:hidden;
  }
  .color-dot span{
    display:block; width:100%; text-align:center; padding:4px 2px 5px;
    font-size:10px; font-weight:800; color:#fff; text-shadow:0 1px 2px rgba(0,0,0,.5);
    background:linear-gradient(to top, rgba(0,0,0,.35), rgba(0,0,0,0));
  }
  .color-dot.active{ border-color: var(--accent); box-shadow:0 0 0 2.5px rgba(125,42,231,.16); }

  /* image section: two columns (properties right, animation squares left in RTL) —
     same 1:1 ratio as the text section below so both columns' edges line up. */
  .image-columns{ display:flex; gap:20px; align-items:flex-start; margin-top:8px; }
  .image-col-main{ flex:1; display:flex; flex-direction:column; gap:14px; min-width:0; }
  .image-col-anim{ flex:1; display:flex; flex-direction:column; gap:14px; min-width:0; }
  @media (max-width: 700px){ .image-columns{ flex-direction:column; } }

  /* Six animation buttons in two rows; reset spans both rows on the left. */
  .anim-grid-sq{ display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); grid-template-rows:repeat(2,90px); gap:12px; width:min(100%,396px); align-self:flex-start; min-width:0; }
  .anim-grid-sq > .center-img-btn{ grid-column:4; grid-row:1 / span 2; width:100%; height:100%; aspect-ratio:auto; }
  .anim-sq{
    justify-self:center; min-width:0; width:min(90px,100%); aspect-ratio:1; border-radius:12px; background:var(--panel-2); border:1.5px solid var(--line);
    display:flex; align-items:center; justify-content:center; font-size:22.5px; color:var(--muted);
    cursor:pointer; font-weight:700; padding:0;
  }
  .anim-sq.active{ border-color:var(--accent); color:var(--accent); background:#F3EAFD; }

  /* label + slider on one line, fixed-feeling slider width via flex-grow+max-width
     (avoids a circular %-width bug that occurs with width:min(px,100%) here) */
  .slider-row{ display:flex; align-items:center; gap:12px; }
  .slider-row input[type=range]{ flex:1; max-width:440px; min-width:0; }
  .intensity-row{ margin-top:0; }
  .intensity-row input[type=range]{ flex:1; width:auto; max-width:292px; }

  /* Keep the labels and percentages on one line while moving the tracks left. */
  .settings-row{ display:flex; align-items:stretch; gap:20px; flex-wrap:wrap; padding-right:56px; }
  .settings-sliders{ display:flex; flex-direction:column; gap:38px; flex:0 0 408px; min-width:0; }
  .settings-sliders .slider-row label{ flex:0 0 148px; min-width:0; white-space:nowrap; }
  .settings-sliders .intensity-row label{ flex-basis:148px; }
  .motion-controls{ padding-top:0; }
  @media (max-width:700px){ .anim-grid-sq{ grid-template-rows:repeat(2,minmax(0,1fr)); } .settings-row{ padding-right:0; } }
  .settings-row > .btn{ flex:none; white-space:nowrap; padding:14px 22px; }
  .center-img-btn img{ width:28px; height:28px; object-fit:contain; }
  .center-img-btn:active{ transform:scale(.94); border-color:var(--accent); background:#F3EAFD; }
  .center-img-btn.pressed{ border-color:var(--accent); background:#F3EAFD; box-shadow:0 0 0 4px rgba(125,42,231,.18); animation:center-button-press .5s ease-out; }
  @keyframes center-button-press{
    0%{ transform:scale(.94); }
    60%{ transform:scale(1.03); }
    100%{ transform:scale(1); }
  }
  @media (prefers-reduced-motion:reduce){ .center-img-btn.pressed{ animation:none; } }

  .upload-row{ display:flex; align-items:stretch; gap:10px; }
  .upload-row .upload-box{ flex:1; max-width:60%; min-width:0; }
  .upload-row .file-chip{ flex:none; white-space:nowrap; margin-top:0; display:flex; align-items:center; }
  .upload-thumb{
    width:64px; flex-shrink:0; border-radius:10px; object-fit:cover;
    border:1.5px solid var(--line);
  }
  /* text section: headline + subline side by side */
  .text-columns{ display:flex; gap:16px; align-items:flex-start; flex-wrap:wrap; padding-right:40px; }
  .text-columns > .text-layer-card{ flex:none; width: calc((var(--music-3col-width, 616px) - 16px) / 2); min-width:0; }
  @media (max-width: 700px){ .text-columns{ flex-direction:column; padding-right:0; } .text-columns > .text-layer-card{ width:100%; } }

  .btn.small{ padding:7px 13px; font-size:15px; align-self:flex-start; }
  .upload-box.compact{ padding:12px; font-size:15px; }

  .upload-box.small{ padding:10px; font-size:14.375px; }

  /* music: horizontally scrolling track row, fills remaining space */
  .music-section{ flex-shrink:0; }
  .track-scroll-wrap{ display:flex; align-items:center; gap:8px; flex-shrink:0; }
  .track-row-scroll{
    display:grid; grid-auto-flow:column; grid-template-rows:repeat(5, 1fr);
    /* grid-auto-columns width is set in JS as a fixed px value (see setTrackGridColumnWidth) —
       percentage-based sizing here has a real CSS circular-dependency bug: when there are
       fewer than 3 total columns, the percentage resolves against the wrong base width and
       cards shrink instead of staying a fixed size. */
    gap:10px; height:320px; overflow-x:auto; overflow-y:hidden; min-width:0;
    scrollbar-width: thin; scrollbar-color: #d5cff0 transparent;
  }
  .track-row-scroll::-webkit-scrollbar{ height:8px; }
  .track-row-scroll::-webkit-scrollbar-track{ background:var(--panel-2); border-radius:8px; }
  .track-row-scroll::-webkit-scrollbar-thumb{ background:#d5cff0; border-radius:8px; }
  .track-row-scroll::-webkit-scrollbar-thumb:hover{ background:var(--accent); }
  .track-scroll-arrow{
    flex-shrink:0; width:32px; height:32px; border-radius:50%; background:var(--panel);
    border:1.5px solid var(--line); color:var(--muted); font-size:22.5px; font-weight:900;
    display:flex; align-items:center; justify-content:center; cursor:pointer; line-height:1;
  }
  .track-scroll-arrow:hover{ border-color:var(--accent); color:var(--accent); }
  .track-scroll-arrow:disabled{ opacity:.3; cursor:default; }
  .track-scroll-arrow:disabled:hover{ border-color:var(--line); color:var(--muted); }

  /* custom always-visible scroll progress bar — doesn't rely on the native OS
     scrollbar, which some browsers/systems hide by default regardless of CSS. */
  .scroll-indicator-track{
    height:6px; border-radius:4px; background:var(--panel-2); margin-top:8px;
    overflow:hidden; flex-shrink:0; cursor:pointer;
  }
  .scroll-indicator-thumb{
    height:100%; border-radius:4px; background:var(--accent-grad);
    width:30%; transform:translateX(0); transition:transform .05s linear;
  }
  .music-extra{ flex-shrink:0; display:flex; flex-direction:column; gap:10px; padding-top:10px; border-top:1px solid var(--line); }

  .swatch-grid{ display:grid; grid-template-columns:repeat(5,1fr); gap:10px; }
  .swatch{
    aspect-ratio:9/16; border-radius:12px; border:2.5px solid transparent;
    background-size:cover; background-position:center; cursor:pointer; position:relative;
    box-shadow: var(--shadow-sm), inset 0 0 0 1px rgba(0,0,0,.04);
  }
  .swatch.active{ border-color: var(--accent); }
  .swatch span{
    position:absolute; bottom:6px; right:6px; left:6px; text-align:center;
    font-size:13.125px; font-weight:700; color:#fff; text-shadow:0 1px 3px rgba(0,0,0,.6);
  }

  .track-grid{ display:flex; flex-direction:column; gap:8px; }
  .track-card{
    display:flex; align-items:center; gap:12px;
    background:var(--panel-2); border:1.5px solid var(--line); border-radius:12px;
    padding:10px 12px; cursor:pointer;
  }
  .track-card:hover{ border-color:#cfc4ef; }
  .track-card.active{ border-color: var(--accent); background:#F3EAFD; }
  .track-row-scroll .track-card{
    flex-direction:row; width:100%; height:100%; padding:0 14px; gap:10px;
  }
  .track-play{
    flex-shrink:0; width:34px; height:34px; border-radius:50%;
    background:var(--panel); border:1.5px solid var(--line); color:var(--text);
    display:flex; align-items:center; justify-content:center; font-size:16.25px; cursor:pointer;
  }
  .track-play:hover{ border-color: var(--accent); color:var(--accent); }
  .track-name{ flex:1; font-size:16.25px; font-weight:700; color:var(--text); }
  .track-row-scroll .track-name{ flex:1; font-size:15.625px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; text-align:right; }
  .track-check{ font-size:18.75px; color:var(--accent); opacity:0; flex-shrink:0; }
  .track-card.active .track-check{ opacity:1; }

  .seg{ display:flex; background:var(--panel-2); border:1.5px solid var(--line); border-radius:11px; padding:3px; gap:3px; flex-wrap:wrap; }
  .seg button{
    flex:1; min-width:64px; background:transparent; border:none; color:var(--muted);
    font-family:inherit; font-size:15.625px; font-weight:700; padding:8px 6px; border-radius:8px; cursor:pointer;
  }
  .seg button.active{ background:var(--accent-grad); color:#fff; }

  .upload-box{
    border:1.5px dashed #cfc4ef; border-radius:12px; padding:18px; text-align:center;
    cursor:pointer; color:var(--muted); font-size:15.625px; position:relative; background:var(--panel-2);
  }
  .upload-box:hover{ border-color: var(--accent); color:var(--text); }
  .upload-box input{ position:absolute; inset:0; opacity:0; cursor:pointer; }
  .file-chip{ font-size:15px; color:var(--good); margin-top:4px; font-weight:700; }

  .text-layer-card{
    border:1.5px solid var(--line); border-radius:14px; padding:14px; background:var(--panel-2);
    display:flex; flex-direction:column; gap:10px; position:relative;
  }
  .text-layer-card .remove{
    position:absolute; top:10px; left:10px; background:none; border:none; color:var(--muted);
    cursor:pointer; font-size:18.75px;
  }
  .text-layer-card .remove:hover{ color:var(--accent); }

  .add-layer-btn{
    border:1.5px dashed #cfc4ef; background:none; color:var(--muted); border-radius:12px; padding:12px;
    font-family:inherit; font-weight:700; font-size:16.25px; cursor:pointer;
  }
  .add-layer-btn:hover{ color:var(--text); border-color:var(--accent); }
  .add-layer-btn:disabled{ opacity:.4; cursor:not-allowed; }

  .adv-toggle{
    display:flex; align-items:center; gap:6px; background:none; border:none; color:var(--accent);
    font-family:inherit; font-size:14.375px; font-weight:700; cursor:pointer; padding:2px 0; align-self:flex-start;
  }
  .adv-toggle:hover{ filter:brightness(1.15); }
  .adv-toggle .arrow{ display:inline-block; transition: transform .18s ease; font-size:12.5px; }
  .adv-toggle.open .arrow{ transform: rotate(90deg); }
  .adv-body{ display:none; flex-direction:column; gap:8px; }
  .adv-body.open{ display:flex; }

  .toggle-row{
    display:flex; align-items:center; justify-content:space-between; gap:12px;
    background:var(--panel-2); border:1.5px solid var(--line); border-radius:14px; padding:14px 16px;
  }
  .switch{ position:relative; width:44px; height:26px; flex-shrink:0; }
  .switch input{ opacity:0; width:0; height:0; }
  .slider-toggle{
    position:absolute; inset:0; background:#D9D3EE; border-radius:20px; cursor:pointer; transition:.2s;
  }
  .slider-toggle:before{
    content:""; position:absolute; width:20px; height:20px; left:3px; top:3px; background:#fff;
    border-radius:50%; transition:.2s; box-shadow: var(--shadow-sm);
  }
  .switch input:checked + .slider-toggle{ background: var(--accent-grad); }
  .switch input:checked + .slider-toggle:before{ transform: translateX(-18px); }

  footer.note{ padding:14px 24px 26px; color:var(--muted); font-size:14.375px; line-height:1.8; border-top:1px solid var(--line); background:var(--panel); }
</style>
</head>
<body>
<div class="app">
  <header>
    <div class="mark">CTS</div>
    <div>
      <h1>Celebrities Top Snap</h1>
      <p>صورة + نص + موسيقى ← فيديو جاهز للنشر بمقاس ٩:١٦</p>
    </div>
  </header>

  <main>
    <section class="preview-pane">
      <div class="stage-wrap" id="stageWrap">
        <canvas id="stage" width="1080" height="1920"></canvas>
      </div>

      <div class="scrubber-row">
        <span class="time-label" id="timeLabel">0.0 / 10.0s</span>
        <input type="range" id="scrubber" min="0" max="300" step="1" value="45">
      </div>

      <div class="transport">
        <button class="btn btn-ghost" id="playBtn">▶ تشغيل المعاينة</button>
        <button class="btn btn-ghost" id="resetBtn">↺ البداية</button>
      </div>

      <button class="btn btn-primary btn-export" id="exportBtn">⬇ تصدير الفيديو</button>

      <div class="export-box" id="exportBox">
        <span id="exportStatus">جارٍ التصدير…</span>
        <div class="hint" style="margin-top:4px;">أبقِ هذا التبويب مفتوحاً وظاهراً على الشاشة أثناء التصدير لضمان التقاط ٣٠ إطار/ثانية كاملة.</div>
        <div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div>
        <div class="export-result" id="exportResult">
          <video id="resultVideo" controls playsinline></video>
    